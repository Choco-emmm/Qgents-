# 复用服务器现有 MySQL；填写服务器对 Docker 可达的地址
DB_HOST=host.docker.internal
DB_PORT=3306
DB_USERNAME=qgents
DB_PASSWORD=replace-with-long-random-value
REDIS_PASSWORD=replace-with-long-random-value
JWT_SECRET=replace-with-at-least-32-random-bytes
DASHSCOPE_API_KEY=
SANDBOX_BACKEND_SERVICE_TOKEN=replace-with-random-service-token
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CALLBACK_URL=https://api.example.com/api/v1/integrations/github/callback
GITHUB_APP_STATE_SECRET=replace-with-random-secret
GITHUB_WEBHOOK_SECRET=replace-with-random-secret
FRONTEND_URL=https://qgents.example.com
CORS_ALLOWED_ORIGINS=https://qgents.example.com
VITE_API_BASE_URL=https://api.example.com/api/v1
CLOUDFLARE_TUNNEL_TOKEN=
# Worker 子容器访问宿主 Docker 的组 ID：Linux 执行 `getent group docker | cut -d: -f3`
DOCKER_GID=999
# 必须是宿主机绝对路径，Worker 创建的子容器才能看到同一份 Workspace
QGENTS_DATA_ROOT=/srv/qgents
# 宿主机 Mihomo 代理监听地址；Mihomo 必须开启 allow-lan: true
PROXY_HOST=host.docker.internal
PROXY_PORT=7890
